generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  userId            String            @id
  email             String
  firstName         String?
  lastName          String?
  hoverStyle        String?           @default("smooth")
  onboardingData    Json?             @default("{}")
  excalidrawLibrary String?
  hasSeenTour       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspaces        Workspace[]
  memberships       WorkspaceMember[]
  designDocs        DesignDoc[]
  teamSignals       TeamSignal[]
  connectedRepos    ConnectedRepo[]
  codebaseTours     CodebaseTour[]
  tourProgress      TourProgress[]
}

model Workspace {
  workspaceId String            @id
  userId      String
  title       String            @default("Untitled Architecture")
  subtitle    String            @default("Personal Workspace")
  elements    String            @default("[]")
  appState    String            @default("{}")
  shareMode   String            @default("public")
  editTokens  String[]          @default([])
  viewTokens  String[]          @default([])
  chats       Json              @default("[]")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [userId])
  members     WorkspaceMember[]
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        String    @default("viewer")
  title       String?
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [userId])

  @@id([userId, workspaceId])
}

model DesignDoc {
  id            String       @id @default(cuid())
  userId        String
  title         String
  type          String
  status        String       @default("Draft")
  summary       String       @default("")
  sections      Json         @default("[]")
  drift         String       @default("clean")
  driftFiles    Json         @default("[]")
  linkedCommits Json         @default("[]")
  linkedDocIds  String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [userId])
  teamSignals   TeamSignal[]
}

model TeamSignal {
  id        String    @id @default(cuid())
  docId     String
  userId    String
  engineer  String
  initial   String
  signal    String
  note      String
  createdAt DateTime  @default(now())
  doc       DesignDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [userId])
}

model ConnectedRepo {
  id        String   @id @default(cuid())
  userId    String
  repoUrl   String
  repoName  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [userId])
}

model CodebaseTour {
  id          String         @id @default(cuid())
  userId      String
  repoId      String?
  title       String
  description String         @default("")
  area        String         @default("general")
  difficulty  String         @default("beginner")
  status      String         @default("Draft")
  graph       Json           @default("{}")
  stops       TourStop[]
  progress    TourProgress[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [userId])
}

model TourStop {
  id        String       @id @default(cuid())
  tourId    String
  order     Int
  title     String
  filePath  String
  lineStart Int?
  lineEnd   Int?
  narration String       @default("")
  keyPoints Json         @default("[]")
  createdAt DateTime     @default(now())
  tour      CodebaseTour @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourProgress {
  id             String       @id @default(cuid())
  tourId         String
  userId         String
  completedStops String[]     @default([])
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  tour           CodebaseTour @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [userId])

  @@unique([tourId, userId])
}
