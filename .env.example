# ──────────────────────────────────────────────────────────────────────────
# FlowState Frontend Environment Variables Template
# Copy this file to '.env' and fill in your values.
# ──────────────────────────────────────────────────────────────────────────

# ── Supabase (Auth + Postgres) ────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-side only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# ── Site URL (used for auth redirects) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Backend WebSocket URL ──────────────────────────────────────────────────────
# Local: ws://localhost:8000
NEXT_PUBLIC_BACKEND_WS_URL=

# ── Prisma Database Connection ─────────────────────────────────────────────────
# Get both from: Supabase dashboard → Settings → Database → Connection string
# DATABASE_URL: use "Transaction" mode (port 6543) — for the Prisma query engine
# DIRECT_URL:   use "Session" mode     (port 5432) — for `prisma db push`
DATABASE_URL=
DIRECT_URL=

# ── Auth setup ──────────────────────────────────────────────────────────────────
# Supabase dashboard → Auth → Email → enable "Email OTP" so the signup
# verification step works with 6-digit codes.

# ── Google Gemini (AI narration, codebase analysis) ─────────────────────────────
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── GitHub (optional — raises API rate limits for repo analysis) ────────────────
# A fine-grained personal access token with public_repo read access
GITHUB_TOKEN=
